# OpsDesk Mobile environment variables
# Copy to `.env` (git-ignored) and fill in. Variables prefixed with EXPO_PUBLIC_
# are inlined into the JS bundle at build time, so never put secrets in them.
# For EAS builds, set the same keys as EAS environment variables per profile.

# Origin of an opsdesk-web deployment (https://github.com/ranazaid/opsdesk-web).
# The client appends /api/v1. Leave EMPTY to run in demo mode with the in-memory
# mock API (works in Expo Go). For a local opsdesk-web (`npm run dev`), use your
# computer's LAN IP so a phone can reach it, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=

# Request timeout for API calls, in milliseconds. Defaults to 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Datadog RUM. Monitoring is only initialised when the client token AND application id are set.
# Requires a development/preview/production build (the native SDK is not part of Expo Go).
EXPO_PUBLIC_DD_CLIENT_TOKEN=
EXPO_PUBLIC_DD_APPLICATION_ID=
# Datadog site: US1, US3, US5, EU1, AP1, AP2 or US1_FED. Defaults to US1.
EXPO_PUBLIC_DD_SITE=US1
# Environment tag reported to Datadog (e.g. development, preview, production).
EXPO_PUBLIC_DD_ENV=development

# --- Build-time only (read by app.config.ts, not shipped in the bundle) ---
# development | preview | production. Set by eas.json build profiles.
APP_VARIANT=development
# EAS project id, required for Expo push tokens on real devices (`npx eas-cli init` prints it).
EAS_PROJECT_ID=
# Optional Expo account / organisation that owns the project.
EXPO_OWNER=
